
 
 .rotate-image {
   width: 45rpx;
   height: 45rpx;
   border-radius: 50%;
   margin-left: 4rpx;
 }

 .locate {
   color: black;
   font-size: 15px;
   font-family:'Courier New', Courier, monospace;
   flex: 1;
   text-align: left;
   /* padding: 0 3px; */
 }


 .swiper-container {
   position: relative;
   z-index: 1;
 }

 .swiper-container .swiper-box {
   height: 375rpx;
   text-align: center;
 }

 .swiper-container .swiper-box image {
   width: 98%;
   height: 375rpx;
   border-radius: 16rpx;
 }

 .swiper-tip-container {
   position: absolute;
   bottom: 1rpx;
   left: 24rpx;
   width: 668rpx;
   color: #fff;
   font-size: 20rpx;
 }

 .swiper-tip-container .swiper-tip-box {
   width: 100%;
   height: 54rpx;
 }

 .swiper-tip-item {
   display: inline-flex;
   align-items: center;
   background: rgba(0, 0, 0, 0.4);
   border-radius: 32rpx;
   padding: 8rpx 16rpx;
 }

 .swiper-tip-item image {
   width: 32rpx;
   height: 32rpx;
   border-radius: 50%;
   flex-shrink: 0;
 }

 .swiper-tip-item text {
   margin-left: 8rpx;
   text-overflow: ellipsis;
   white-space: nowrap;
   overflow: hidden;
 } 

 /* iPhone6 的屏幕宽度为 375px ，共有 750 个物理像素，则 750rpx = 375px = 750 物理像素  1rpx=0.5px=1物理像素 */
 .recommend-title {
  text-align: center;
  font-size: 34rpx;
  height: 38rpx;
  line-height: 38rpx;
  margin-top: 50rpx;
  margin-bottom: 20rpx;
}


 .grid-container {
   margin-top: 50rpx;
   display: grid;
   grid-template-columns: 1fr  1fr;
   column-gap: 6rpx;
   row-gap: 60rpx;
   grid-auto-rows: minmax(360rpx, auto);

 }

 .grid-container .grid-box {
 
   display: grid;
   grid-template-columns: 1fr auto 1fr;
   column-gap: 6rpx;
   row-gap: 60rpx;
   grid-auto-rows: minmax(360rpx, auto);
   text-align: center;
 }


 .grid-box::before {
  content: "";
  width: 1rpx; /* 竖线的宽度 */
  background-color: #ccc; /* 竖线的颜色 */
  height: 80%; /* 高度与父容器一致 */
}

.grid-box > view {
  position: relative; /* 为了定位竖线 */
}

.grid-box > view:first-child::before {
  content: none; /* 移除第一个 view 的竖线 */
}

 .grid-box .grid-img {
  margin-top: 50rpx;
   width: 120rpx;
   height: 120rpx;
 }
