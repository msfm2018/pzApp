<page-meta root-font-size="system" />
<view class="page" data-weui-theme="{{theme}}" data-weui-mode="{{mode}}">

  <view class="weui-form weui-bottom-fixed-opr-page">
    <view class="weui-form__bd weui-bottom-fixed-opr-page__content">
      <view class="weui-form__text-area">
        <h2 class="weui-form__title">就诊信息</h2>
      </view>
      <view class="weui-form__control-area">
        <view class="weui-cells__group weui-cells__group_form">
          <view class="weui-cells weui-cells_form">

            <view class="weui-cell weui-cell_active">
              <view class="weui-cell__hd"><label class="weui-label">医院</label></view>
              <view class="weui-cell__bd">
                <view class="weui-cell__bd">
                  <picker aria-role="combobox" bindchange="hospitalChange" range="{{hospitalList}}">
                    <view class="weui-select">{{selectedHospital}}</view>
                  </picker>
                </view>
              </view>
            </view>

            <view class="weui-cell weui-cell_active">
              <view class="weui-cell__hd"><label class="weui-label">科室</label></view>
              <view class="weui-cell__bd">
                <view class="weui-cell__bd">
                  <picker aria-role="combobox" bindchange="departChange" range="{{departList}}">
                    <view class="weui-select">{{depart}}</view>
                  </picker>
                </view>
              </view>
            </view>


            <view class="weui-cell weui-cell_active">
              <view class="weui-cell__hd"><label class="weui-label">日期</label></view>
              <view class="weui-cell weui-cell_active">

         
                <view class="weui-cell__bd">
                  <picker mode="date" aria-role="combobox" aria-labelledby="js_date" value="{{date}}" start="2024-04-01" end="2039-01-01" bindchange="bindDateChange">
                    <view class="weui-input">{{date}}</view>
                  </picker>
                </view>
              </view>

            </view>

            <view class="weui-cell weui-cell_active">

              <view class="weui-cell__hd"><label class="weui-label">时间</label></view>
              <view class="weui-cell weui-cell_active">

                <view class="weui-cell__bd">
                  <picker aria-role="combobox" aria-labelledby="js_time" mode="time" value="{{time}}" start="09:01" end="21:01" bindchange="bindTimeChange">
                    <view class="weui-input">{{time}}</view>
                  </picker>
                </view>
              </view>
            </view>


            <view class="weui-cell weui-cell_active">
              <view class="weui-cell__hd"><label class="weui-label">就诊人</label></view>
              <view class="weui-cell__bd">
                <input class="weui-input" type="text" placeholder="就诊人" value="{{nickName}}" bindinput="onSetNickName" placeholder-class="weui-input__placeholder" />
              </view>
            </view>
            <view class="weui-cell weui-cell_active">
              <view class="weui-cell__hd"><label class="weui-label">手机号</label></view>
              <view class="weui-cell__bd">
                <input class="weui-input" type="number" placeholder="请输入手机号" value="{{phone}}" bindinput="onSetPhone" placeholder-class="weui-input__placeholder" />
              </view>
            </view>

    
         
           
            <view class="weui-form__control-area mp">
             
              <view class="weui-cells__group weui-cells__group_form">
                <!-- <view class="weui-cells__title">备注</view> -->
                <view class="weui-cells weui-cells_form">
                  <view class="weui-cell" hover-class="weui-cell_active">
                    <view class="weui-cell__bd">
                      <textarea class="weui-textarea" placeholder="备注信息" value="{{textAreaValue}}"  bindinput="onTextAreaInput" placeholder-class="weui-input__placeholder" rows="3"></textarea>
                      <view aria-role="option" class="weui-textarea-counter"><span>0</span>/200</view>
                    </view>
                  </view>
                </view>
              </view>
            </view>

          </view>

        </view>
      </view>
    </view>


    <view class="weui-form__ft">
              <view class="weui-form__opr-area">
                <view class="weui-btn weui-btn_primary" aria-role="button" bindtap="buttonClick">确定</view>
              </view>
            </view>
  </view>
</view>