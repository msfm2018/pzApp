{
  "pages": [
    "pages/main",
    "pages/login/login",
    "pages/home/index",
    "pages/about/index",

    "pages/order/index",
    "pkgC/base/index",
    "pages/companions/index",
    "pages/protocol/p1",
    "pages/protocol/p2"
  ],
  "subpackages": [
    {
      "root": "pkgA",
      "pages": [
        "pages/index",
        "pages/doc/desc",
        "pages/doc/start/page1"
        
      ]
    },
    {
      "root": "pkgB",
      "pages": [
        "pages/set/index",
        "pages/person/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/about/index": {
      "packages": [
        "pkgB"
      ],
      "network": "all"
    }
  },
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarTitleText": "小毛驴助医",
    "navigationBarTextStyle": "black",
    "onReachBottomDistance": 50,
    "navigationBarBackgroundColor": "#EDEDED",
    "backgroundColor": "#EDEDED",
    "navigationStyle": "default"
  },

  "tabBar": {
    "color": "#6e6d6b",
    "selectedColor": "#e64340",
    "borderStyle": "white",
    "backgroundColor": "#EDEDED",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页",
        "iconPath": "/images/tabs/home.png",
        "selectedIconPath": "/images/tabs/home_active.png"
      },
      {
        "pagePath": "pages/order/index",
        "text": "订单",
        "iconPath": "/images/tabs/order.png",
        "selectedIconPath": "/images/tabs/order_active.png"
      },
      {
        "pagePath": "pages/about/index",
        "text": "我的",
        "iconPath": "/images/tabs/user.png",
        "selectedIconPath": "/images/tabs/user_active.png"
      }
    ]
  },
  "requiredPrivateInfos": [
    "getLocation",
    "chooseAddress",
    "chooseLocation"
  ],
  "permission": {
    "scope.userLocation": {
      "desc": "获取最近的商家"
    }
  },
  "useExtendedLib": { 
    "weui": true
  },
  "usingComponents": {},
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json"
}